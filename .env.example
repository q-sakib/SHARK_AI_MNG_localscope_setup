# SHARK AI MNG — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit credentials.
# Run: source .env  (or use direnv — see .envrc)

# ─────────────────────────────────────────────────
# ANTHROPIC / CLAUDE
# ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Default Claude model for claude CLI / SDK
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────
# OLLAMA (local inference)
# ─────────────────────────────────────────────────
# Override if Ollama runs on another machine
OLLAMA_HOST=http://localhost:11434

# Default model for caveman compression (fast = 1.5b-base, quality = 14b)
CAVEMAN_MODEL=qwen2.5-coder:14b

# ─────────────────────────────────────────────────
# GITHUB
# ─────────────────────────────────────────────────
# Classic or fine-grained PAT — scopes: repo, read:org, workflow
GITHUB_TOKEN=ghp_...

# Used by gh CLI config (usually ~/.config/gh/hosts.yml — but you can override here)
# GITHUB_ENTERPRISE_URL=https://github.yourcompany.com
# GH_HOST=github.yourcompany.com

# ─────────────────────────────────────────────────
# BITBUCKET
# ─────────────────────────────────────────────────
BITBUCKET_USERNAME=your-bitbucket-username
# App password (not your account password) — scopes: repo, pull-request
BITBUCKET_APP_PASSWORD=ATBBxxxx

# Atlassian API token — used by pr-review.sh / pr-poller.sh (preferred over app password)
# Scopes: read:repository, read:pullrequest, write:pullrequest
BB_EMAIL=you@schertech.com
BB_TOKEN=your-atlassian-api-token

# Optional: Bitbucket Server (self-hosted)
# BITBUCKET_SERVER_URL=https://bitbucket.yourcompany.com
# BITBUCKET_SERVER_TOKEN=...

# ─────────────────────────────────────────────────
# GITLAB (if used)
# ─────────────────────────────────────────────────
# GITLAB_TOKEN=glpat-...
# GITLAB_URL=https://gitlab.com

# ─────────────────────────────────────────────────
# NPM (private registry)
# ─────────────────────────────────────────────────
# NPM_TOKEN=npm_...
# NPM_REGISTRY=https://registry.yourcompany.com

# ─────────────────────────────────────────────────
# DOCKER / CONTAINER REGISTRY
# ─────────────────────────────────────────────────
# DOCKER_REGISTRY=ghcr.io
# DOCKER_REGISTRY_TOKEN=...

# ─────────────────────────────────────────────────
# DATABASE (local dev)
# ─────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/devdb
# MYSQL_URL=mysql://user:password@localhost:3306/devdb
# MONGODB_URI=mongodb://localhost:27017/devdb

# ─────────────────────────────────────────────────
# OPENAI (if used alongside Claude)
# ─────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────────
# SLACK / NOTIFICATIONS
# ─────────────────────────────────────────────────
# SLACK_TOKEN=xoxb-...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─────────────────────────────────────────────────
# AICTX / MEMORY SYSTEM
# ─────────────────────────────────────────────────
SHARK_AI_DIR=/Users/shark/SHARK_AI_MNG_localscope_setup

# ─────────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────────
# GIT_AUTHOR_EMAIL=you@domain.com
# GIT_AUTHOR_NAME=Your Name
