#!/usr/bin/env bash
set -Eeuo pipefail

CLAUDE_DIR="${HOME}/.claude"
AI_DIR="${CLAUDE_DIR}/ai"
VERSION="2.0.0"
SHARK_DIR="${HOME}/SHARK_AI_MNG_localscope_setup"

log() { printf '\033[1;36m[AI]\033[0m %s\n' "$*"; }
ok()  { printf '\033[1;32m[OK]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }

cmd="${1:-help}"

case "$cmd" in
  version)
    echo "AI Claude Workflow Kit ${VERSION}"
    ;;

  doctor)
    echo "SHARK AI MNG ENVIRONMENT"
    echo "────────────────────────────────────────"
    for x in claude ollama caveman jq yq rg fd fzf bat eza delta just shellcheck; do
      command -v "$x" >/dev/null 2>&1 && ok "$x" || warn "$x missing"
    done
    echo
    echo "CLAUDE STRUCTURE"
    for d in CLAUDE.md skills agents hooks commands ai; do
      [[ -e "${CLAUDE_DIR}/${d}" ]] && ok "~/.claude/${d}" || warn "~/.claude/${d} missing"
    done
    echo
    echo "COMMANDS (/cpres etc)"
    find "${CLAUDE_DIR}/commands" -name '*.md' -print 2>/dev/null | sort || warn "No commands installed"
    echo
    if command -v ollama >/dev/null 2>&1; then
      echo "OLLAMA"
      ollama --version || true
      ollama list || true
    fi
    ;;

  status)
    echo "AI WORKFLOW STATUS"
    echo "────────────────────────────────────────"
    echo "Claude dir: ${CLAUDE_DIR}"
    echo "AI dir:     ${AI_DIR}"
    echo
    echo "Skills:   $(find "${CLAUDE_DIR}/skills" -type f 2>/dev/null | wc -l | tr -d ' ')"
    echo "Agents:   $(find "${CLAUDE_DIR}/agents" -type f 2>/dev/null | wc -l | tr -d ' ')"
    echo "Hooks:    $(find "${CLAUDE_DIR}/hooks" -type f 2>/dev/null | wc -l | tr -d ' ')"
    echo "Commands: $(find "${CLAUDE_DIR}/commands" -type f 2>/dev/null | wc -l | tr -d ' ')"
    echo "Prompts:  $(find "${AI_DIR}/prompts" -type f 2>/dev/null | wc -l | tr -d ' ')"
    echo "Evals:    $(find "${AI_DIR}/evaluations/cases" -type f 2>/dev/null | wc -l | tr -d ' ')"
    ;;

  models)
    command -v ollama >/dev/null 2>&1 || { warn "Ollama is not installed"; exit 1; }
    ollama list
    ;;

  pull)
    shift || true
    [[ $# -gt 0 ]] || { echo "Usage: ai pull <ollama-model>"; exit 2; }
    command -v ollama >/dev/null 2>&1 || { warn "Ollama is not installed"; exit 1; }
    ollama pull "$1"
    ;;

  run)
    shift || true
    [[ $# -gt 0 ]] || { echo "Usage: ai run <ollama-model> [ollama args...]"; exit 2; }
    command -v ollama >/dev/null 2>&1 || { warn "Ollama is not installed"; exit 1; }
    ollama run "$@"
    ;;

  compress|cpres)
    shift || true
    command -v caveman >/dev/null 2>&1 || { warn "caveman not installed. Run: bootstrap.sh"; exit 1; }
    mode="${1:-compress}"
    log "Compressing via caveman (${CAVEMAN_MODEL:-qwen2.5-coder:1.5b})..."
    caveman "$mode"
    ;;

  qwen)
    shift || true
    size="${1:-14b}"
    command -v ollama >/dev/null 2>&1 || { warn "Ollama not installed"; exit 1; }
    log "Running qwen2.5-coder:${size}..."
    ollama run "qwen2.5-coder:${size}"
    ;;

  project)
    shift || true
    name="${1:-}"
    [[ -n "$name" ]] || { echo "Usage: ai project <name>"; exit 2; }
    target="${SHARK_DIR}/projects/${name}"
    mkdir -p "${target}/.claude" "${target}/docs/architecture" \
      "${target}/docs/decisions" "${target}/docs/api" \
      "${target}/docs/database" "${target}/docs/security"
    copy_if_missing "${CLAUDE_DIR}/ai/workflows/project-CLAUDE.template.md" "${target}/CLAUDE.md" 2>/dev/null || true
    touch "${target}/PROJECT_CONTEXT.md" "${target}/ARCHITECTURE.md" "${target}/PROGRESS.md"
    ok "AI project initialized: ${target}"
    echo "  cd ${target} && claude"
    ;;

  claude-local)
    shift || true
    command -v ollama >/dev/null 2>&1 || { warn "Ollama is not installed"; exit 1; }
    command -v claude >/dev/null 2>&1 || { warn "Claude Code is not installed"; exit 1; }
    model="${1:-qwen2.5-coder:14b}"
    log "Launching Claude Code through Ollama with model: ${model}"
    exec ollama run "$model"
    ;;

  context)
    echo "Context discipline:"
    echo "  /context    inspect context usage"
    echo "  /memory     inspect loaded memory"
    echo "  /mcp        inspect MCP servers/tools"
    echo
    echo "Keep stable policy in CLAUDE.md; put large workflows in skills."
    ;;

  memory)
    echo "AI MEMORY"
    echo "────────────────────────────────────────"
    find "${AI_DIR}" -maxdepth 3 -type f \
      \( -name '*.md' -o -name '*.yaml' -o -name '*.yml' -o -name '*.json' \) \
      -print 2>/dev/null | sort
    ;;

  workflow)
    echo "Available workflow skills:"
    find "${CLAUDE_DIR}/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print 2>/dev/null | sort
    ;;

  evaluate)
    echo "Evaluation cases:"
    find "${AI_DIR}/evaluations/cases" -type f -print 2>/dev/null | sort
    echo
    echo "Evaluation results:"
    find "${AI_DIR}/evaluations/results" -type f -print 2>/dev/null | sort
    ;;

  benchmark)
    command -v hyperfine >/dev/null 2>&1 || { warn "hyperfine is not installed"; exit 1; }
    echo "Use this for repeatable local CLI/model benchmarks."
    echo "Example:"
    echo "  hyperfine --warmup 1 'ollama run qwen3-coder \"Explain SOLID\"'"
    ;;

  backup)
    stamp="$(date +%Y%m%d-%H%M%S)"
    out="${AI_DIR}/backups/claude-${stamp}.tar.gz"
    mkdir -p "$(dirname "$out")"
    tar -czf "$out" -C "${HOME}" .claude
    ok "Backup: $out"
    ;;

  update)
    if command -v brew >/dev/null 2>&1; then
      brew update
      brew upgrade
    fi
    if command -v ollama >/dev/null 2>&1; then
      ollama --version || true
    fi
    echo "Re-run ${SHARK_DIR}/bootstrap.sh to reconcile missing files."
    ;;


  help|*)
    cat <<'EOF'
SHARK AI MNG — ai helper

Usage:
  ai doctor              Check AI environment (tools, Claude dirs, Ollama)
  ai status              Show Claude workspace status
  ai models              List Ollama models
  ai pull MODEL          Pull an Ollama model
  ai run MODEL           Run an Ollama model interactively
  ai qwen [14b|1.5b]     Quick-launch qwen2.5-coder (default: 14b)
  ai compress [MODE]     Compress stdin via caveman (compress|summarize|strip)
  ai cpres [MODE]        Alias for compress
  ai claude-local MODEL  Run Ollama model locally
  ai context             Context-management guidance
  ai memory              List AI memory/workflow files
  ai workflow            List installed workflow skills
  ai evaluate            Show evaluation cases/results
  ai benchmark           Benchmark helper
  ai backup              Backup ~/.claude
  ai update              Update Homebrew tools
  ai project NAME        Initialize new project in projects/NAME
  ai version             Print version
EOF
    ;;
esac
